<?xml version="1.0" encoding="utf-8"?>
<!-- ZT Home on the home screen: devices and scenes by name. A tile opens
     the app, which carries the tap out once unlocked. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/home_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="@dimen/zt_widget_header_icon"
            android:layout_height="@dimen/zt_widget_header_icon"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            style="@style/ZtWidget.AppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/home_widget_name" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/home_widget_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnWidth="110dp"
            android:horizontalSpacing="6dp"
            android:numColumns="auto_fit"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />

        <LinearLayout
            android:id="@+id/home_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/home_widget_empty_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_zt_widget_lock"
                android:tint="@color/zt_widget_on_surface_variant" />

            <TextView
                android:id="@+id/home_widget_empty_text"
                style="@style/ZtWidget.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="3"
                android:text="@string/home_widget_locked" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
